# Staging (EC2). Sao chép thành .env.staging rồi điền giá trị thật. File .env.staging KHÔNG được commit.
#   copy .env.staging.example .env.staging

APP_NAME="iWeb News"
APP_ENV=staging
APP_DEBUG=false
# IP/DNS public của EC2
APP_URL=http://<EC2_PUBLIC_IP>
# Sinh bằng: docker run --rm <image> php artisan key:generate --show
APP_KEY=

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Laravel kết nối DB (host = tên service "db" trong compose) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=iweb_news
DB_USERNAME=iweb
DB_PASSWORD=<mật khẩu ngẫu nhiên>

# --- Container MySQL đọc các biến này khi khởi tạo lần đầu (phải khớp DB_*) ---
MYSQL_DATABASE=iweb_news
MYSQL_USER=iweb
MYSQL_PASSWORD=<giống DB_PASSWORD>
MYSQL_ROOT_PASSWORD=<mật khẩu root ngẫu nhiên>

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
