# Staging (EC2). Sao chép thành .env.staging rồi điền giá trị thật. File .env.staging KHÔNG được commit.
#   copy .env.staging.example .env.staging

APP_NAME="iWeb News"
APP_ENV=staging
APP_DEBUG=false
# Tên miền public (HTTPS do Caddy lo, xem Caddyfile.staging)
APP_URL=https://tuantv.link
# Sinh bằng: docker run --rm <image> php artisan key:generate --show
APP_KEY=

# --- Đăng nhập Basic Auth do Caddy yêu cầu (xem Caddyfile.staging) ---
# Sinh mã băm: docker run --rm caddy:2 caddy hash-password --plaintext '<mật khẩu>'
# BẮT BUỘC đặt trong nháy đơn '...' vì mã băm chứa ký tự $ (nếu không docker compose sẽ hiểu nhầm là biến).
BASIC_AUTH_USER=tuantv
BASIC_AUTH_HASH='<mã băm bcrypt>'

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Laravel kết nối DB (host = tên service "db" trong compose) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=iweb_news
DB_USERNAME=iweb
DB_PASSWORD=<mật khẩu ngẫu nhiên>

# --- Container MySQL đọc các biến này khi khởi tạo lần đầu (phải khớp DB_*) ---
MYSQL_DATABASE=iweb_news
MYSQL_USER=iweb
MYSQL_PASSWORD=<giống DB_PASSWORD>
MYSQL_ROOT_PASSWORD=<mật khẩu root ngẫu nhiên>

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
