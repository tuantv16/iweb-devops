# Dev/Local (Docker Compose). Sao chép thành .env.local rồi điền APP_KEY:
#   copy .env.local.example .env.local
# File .env.local KHÔNG được commit.

APP_NAME="iWeb News"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# Sinh bằng: docker compose run --rm app php artisan key:generate --show
APP_KEY=

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# --- Laravel kết nối DB (host = tên service "db" trong compose) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=iweb_news
DB_USERNAME=iweb
DB_PASSWORD=iweb_local_pw

# --- Container MySQL đọc các biến này khi khởi tạo lần đầu (giá trị phải khớp DB_* ở trên) ---
MYSQL_DATABASE=iweb_news
MYSQL_USER=iweb
MYSQL_PASSWORD=iweb_local_pw
MYSQL_ROOT_PASSWORD=root_local_pw

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
